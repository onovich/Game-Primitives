{
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/response-template-0.1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/localId"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "familiarityTemplate": {
      "additionalProperties": false,
      "properties": {
        "exact_result_knowledge": {
          "const": "<none|suspected|known|unknown>"
        },
        "exact_rule_knowledge": {
          "const": "<none|suspected|known|unknown>"
        },
        "exact_variant_knowledge": {
          "const": "<none|suspected|known|unknown>"
        },
        "project_exposure": {
          "const": "<none|limited|substantial|unknown>"
        },
        "recognition_status": {
          "const": "<none|suspected|identified>"
        },
        "recognized_family": {
          "type": "null"
        },
        "recognized_work": {
          "type": "null"
        },
        "related_genre_experience": {
          "const": "<none|limited|extensive|unknown>"
        }
      },
      "required": [
        "exact_result_knowledge",
        "exact_rule_knowledge",
        "exact_variant_knowledge",
        "project_exposure",
        "recognition_status",
        "recognized_family",
        "recognized_work",
        "related_genre_experience"
      ],
      "type": "object"
    },
    "localId": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "pollutionTemplate": {
      "additionalProperties": false,
      "properties": {
        "familiarity": {
          "$ref": "#/$defs/familiarityTemplate"
        },
        "integrity_exposures": {
          "maxItems": 0,
          "type": "array"
        },
        "stage_update_note": {
          "type": "null"
        }
      },
      "required": [
        "familiarity",
        "integrity_exposures",
        "stage_update_note"
      ],
      "type": "object"
    },
    "predictionAlternativeTemplate": {
      "additionalProperties": false,
      "properties": {
        "alternative_id": {
          "pattern": "^<required-local-id-[12]>$",
          "type": "string"
        },
        "description": {
          "pattern": "^<required-compatible-world-description-[12]>$",
          "type": "string"
        },
        "expectations": {
          "items": {
            "$ref": "#/$defs/predictionExpectationTemplate"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "alternative_id",
        "description",
        "expectations"
      ],
      "type": "object"
    },
    "predictionAnswerTemplate": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "maxItems": 0,
          "type": "array"
        },
        "case_id": {
          "minLength": 1,
          "type": "string"
        },
        "compatible_alternatives": {
          "items": {
            "$ref": "#/$defs/predictionAlternativeTemplate"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "confidence_percent": {
          "const": "<integer-0-100>"
        },
        "expectations": {
          "items": {
            "$ref": "#/$defs/predictionExpectationTemplate"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "prediction_status": {
          "const": "<determinate|indeterminate>"
        },
        "reasoning": {
          "const": "<required-explanation>"
        },
        "supporting_record_ids": {
          "maxItems": 0,
          "type": "array"
        }
      },
      "required": [
        "assumptions",
        "case_id",
        "compatible_alternatives",
        "confidence_percent",
        "expectations",
        "prediction_status",
        "reasoning",
        "supporting_record_ids"
      ],
      "type": "object"
    },
    "predictionExpectationTemplate": {
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "$ref": "#/$defs/localId"
        },
        "expectation_kind": {
          "pattern": "^<[^<>]+>$",
          "type": "string"
        },
        "observation_id": {
          "$ref": "#/$defs/localId"
        },
        "tolerance_rule_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/localId"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/predictionValueTemplate"
        }
      },
      "required": [
        "configuration_id",
        "expectation_kind",
        "observation_id",
        "tolerance_rule_id",
        "value"
      ],
      "type": "object"
    },
    "predictionPayloadTemplate": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/blind-response-interface-0.1.1.schema.json"
        },
        "artifact_type": {
          "const": "prediction_response_payload"
        },
        "artifact_version": {
          "const": "0.1.1"
        },
        "pollution": {
          "$ref": "#/$defs/pollutionTemplate"
        },
        "prediction_answers": {
          "items": {
            "$ref": "#/$defs/predictionAnswerTemplate"
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "$schema",
        "artifact_type",
        "artifact_version",
        "pollution",
        "prediction_answers"
      ],
      "type": "object"
    },
    "predictionValueTemplate": {
      "additionalProperties": false,
      "properties": {
        "serialized_value": {
          "const": "<required-string>"
        },
        "unit": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_type": {
          "pattern": "^<[^<>]+>$",
          "type": "string"
        }
      },
      "required": [
        "serialized_value",
        "unit",
        "value_type"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/response-template-0.1.1.schema.json"
    },
    "artifact_type": {
      "const": "prediction_response_template"
    },
    "artifact_version": {
      "const": "0.1.1"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "participant_contract": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/prediction-participant-response-contract-0.1.1.schema.json"
    },
    "run_id": {
      "pattern": "^(?:continuous|rehearsal)-[0-9]{3}$",
      "type": "string"
    },
    "stage": {
      "const": "prediction"
    },
    "target_response_schema": {
      "$ref": "#/$defs/artifactReference"
    },
    "template_id": {
      "$ref": "#/$defs/localId"
    },
    "template_payload": {
      "$ref": "#/$defs/predictionPayloadTemplate"
    }
  },
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "created_at",
    "participant_contract",
    "run_id",
    "stage",
    "target_response_schema",
    "template_id",
    "template_payload"
  ],
  "title": "Game Primitives Blind Prediction Response Template 0.1.1",
  "type": "object"
}
