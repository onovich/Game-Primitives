          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/sha256"
        },
        "baseline_value": {
          "const": false
        },
        "changed_paths": {
          "const": [
            "Assets/Fighter/F00/F00.asset"
          ]
        },
        "field": {
          "const": "canCancelOnWhiff"
        },
        "patch_sha256": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/sha256"
        },
        "variant_asset_sha256": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/sha256"
        },
        "variant_value": {
          "const": true
        }
      },
      "required": [
        "asset_path",
        "baseline_asset_sha256",
        "baseline_value",
        "changed_paths",
        "field",
        "patch_sha256",
        "variant_asset_sha256",
        "variant_value"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "external_evidence": {
      "$ref": "#/$defs/externalFile"
    },
    "fixture_surfaces": {
      "additionalProperties": false,
      "properties": {
        "formal_execution": {
          "items": {
