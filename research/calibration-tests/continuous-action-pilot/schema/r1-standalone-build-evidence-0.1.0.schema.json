  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "build_gate_status",
    "case_id",
    "claims",
    "configurations",
    "controlled_variant",
    "created_at",
    "external_evidence",
    "fixture_surfaces",
    "formal_execution",
    "process_tracking",
    "reproducibility",
    "run_id",
    "source_identity",
    "synthetic_smoke",
    "toolchain"
