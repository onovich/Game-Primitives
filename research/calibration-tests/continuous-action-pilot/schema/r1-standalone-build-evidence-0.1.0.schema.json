        "formal_environment_present": {
          "const": false
        },
        "formal_input_executed": {
          "const": false
        },
        "formal_input_path_accepted": {
          "const": false
        },
        "formal_input_read": {
          "const": false
        },
        "formal_result_created": {
          "const": false
        },
        "formal_runner_executed": {
          "const": false
        },
        "permit_created": {
          "const": false
        },
        "predictions_created": {
          "const": false
        }
