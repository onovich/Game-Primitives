        "compatibility_layer_contains_rule_logic": {
          "const": false
        },
        "exact_frozen_fighter_bytes_compiled": {
          "const": true
        },
        "formal_test_body_compiled": {
          "const": true
        },
        "formal_test_body_executed": {
          "const": false
        }
      },
      "required": [
        "baseline_variant_compiled_source_hashes_identical",
        "compatibility_layer_contains_rule_logic",
        "exact_frozen_fighter_bytes_compiled",
        "formal_test_body_compiled",
        "formal_test_body_executed"
      ],
      "type": "object"
    },
    "configurations": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "configuration_id": {
                "const": "config.baseline"
              }
            },
            "required": [
              "configuration_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "configuration_id": {
                "const": "config.variant"
              }
            },
            "required": [
