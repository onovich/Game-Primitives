{
  "$defs": {
    "artifactReference": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/artifactReference"
    },
    "buildOutput": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "external_path": {
          "minLength": 1,
          "type": "string"
        },
        "output_id": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/localId"
        },
        "output_kind": {
          "enum": [
            "formal_execution",
            "synthetic_smoke"
          ]
        },
        "repository_storage": {
          "const": false
        },
        "sha256": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "bytes",
        "external_path",
        "output_id",
        "output_kind",
        "repository_storage",
        "sha256"
      ],
      "type": "object"
    },
    "configurationBuild": {
      "additionalProperties": false,
      "properties": {
        "build_attempt_id": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/localId"
        },
        "build_exit_code": {
          "const": 0
        },
        "configuration_id": {
          "enum": [
            "config.baseline",
            "config.variant"
          ]
        },
        "formal_build_exit_code": {
          "const": 0
        },
        "formal_restore_exit_code": {
          "const": 0
        },
        "outputs": {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "output_kind": {
                    "const": "formal_execution"
                  }
                },
                "required": [
                  "output_kind"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "output_kind": {
                    "const": "synthetic_smoke"
                  }
                },
                "required": [
                  "output_kind"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            }
          ],
          "items": {
            "$ref": "#/$defs/buildOutput"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "restore_exit_code": {
          "const": 0
        },
        "warning_count": {
          "const": 0
        }
      },
      "required": [
        "build_attempt_id",
        "build_exit_code",
        "configuration_id",
        "formal_build_exit_code",
        "formal_restore_exit_code",
        "outputs",
        "restore_exit_code",
        "warning_count"
      ],
      "type": "object"
    },
    "externalFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "external_path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "bytes",
        "external_path",
        "sha256"
      ],
      "type": "object"
    },
    "processRecord": {
      "additionalProperties": false,
      "properties": {
        "alive_after": {
          "const": 0
        },
        "exit_code": {
          "const": 0
        },
        "pid": {
          "minimum": 1,
          "type": "integer"
        },
        "step": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "alive_after",
        "exit_code",
        "pid",
        "step"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/r1-standalone-build-evidence-0.1.0.schema.json",
