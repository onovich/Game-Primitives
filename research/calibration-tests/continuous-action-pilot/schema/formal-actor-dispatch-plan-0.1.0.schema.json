{
  "$defs": {
    "artifactReference": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "byte_length",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "promptReference": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "minimum": 1,
          "type": "integer"
        },
        "encoding": {
          "const": "utf-8"
        },
        "path": {
          "pattern": "^research/calibration-tests/continuous-action-pilot/runs/continuous-002/inputs/dispatch/prompts/stage[12]-p0[1-4]\\.prompt\\.txt$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "byte_length",
        "encoding",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "runtimeBindingTemplate": {
      "additionalProperties": false,
      "properties": {
        "actor_descriptor": {
          "type": "null"
        },
        "session_id": {
          "type": "null"
        },
        "stage1_dispatch_receipt": {
          "type": "null"
        },
        "stage2_dispatch_receipt": {
          "type": "null"
        },
        "thread_id": {
          "type": "null"
        }
      },
      "required": [
        "actor_descriptor",
        "session_id",
        "stage1_dispatch_receipt",
        "stage2_dispatch_receipt",
        "thread_id"
      ],
      "type": "object"
    },
    "seatCommon": {
      "additionalProperties": false,
      "properties": {
        "actor_role": {
          "const": "blind_reconstructor_predictor"
        },
        "condition": {
          "enum": [
            "rich",
            "atomic"
          ]
        },
        "runtime_binding": {
          "$ref": "#/$defs/runtimeBindingTemplate"
        },
        "seat_id": {
          "pattern": "^p0[1-4]$",
          "type": "string"
        },
        "stage1_prompt": {
          "$ref": "#/$defs/promptReference"
        },
        "stage2_prompt": {
          "$ref": "#/$defs/promptReference"
        }
      },
      "required": [
        "actor_role",
        "condition",
        "runtime_binding",
        "seat_id",
        "stage1_prompt",
        "stage2_prompt"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
