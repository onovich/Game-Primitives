{
  "$defs": {
    "artifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/localId"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "caseId": {
      "pattern": "^CA-R[1-3]$",
      "type": "string"
    },
    "caseProbe": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "case_id": {
          "$ref": "#/$defs/caseId"
        },
        "next_safe_action": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "blocked_license_activation",
            "blocked_missing_toolchain",
            "compatibility_probe_passed",
            "neutral_probe_passed",
            "not_checked",
            "ready_for_compatibility_probe",
            "ready_for_neutral_probe"
          ]
        }
      },
      "required": [
        "blockers",
        "case_id",
        "next_safe_action",
        "status"
      ],
      "type": "object"
    },
    "localId": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "toolRecord": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/build-feasibility-0.1.0.schema.json#/$defs/toolRecord"
    }
  },
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/build-feasibility-0.1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/build-feasibility-0.1.1.schema.json"
    },
    "artifact_type": {
      "const": "build_feasibility_probe"
    },
    "artifact_version": {
      "const": "0.1.1"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/caseProbe"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "evidence_artifacts": {
      "items": {
        "$ref": "#/$defs/artifactReference"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "formal_input_executed": {
      "const": false
    },
    "formal_result_produced": {
      "const": false
    },
    "host": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "minLength": 1,
          "type": "string"
        },
        "operating_system": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "architecture",
        "operating_system"
      ],
      "type": "object"
    },
    "probed_at": {
      "format": "date-time",
      "type": "string"
    },
    "run_id": {
      "const": "continuous-001"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/toolRecord"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "cases",
    "evidence_artifacts",
    "formal_input_executed",
    "formal_result_produced",
    "host",
    "probed_at",
    "run_id",
    "tools"
  ],
  "title": "Game Primitives Continuous Action Build Feasibility Probe 0.1.1",
  "type": "object"
}
