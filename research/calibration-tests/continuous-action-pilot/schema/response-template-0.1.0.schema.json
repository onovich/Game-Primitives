{
  "$defs": {
    "artifactReference": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/artifactReference"
    },
    "caseId": {
      "pattern": "^CA-R[1-3]$",
      "type": "string"
    },
    "familiarityTemplate": {
      "additionalProperties": false,
      "properties": {
        "exact_result_knowledge": {
          "const": "<none|suspected|known|unknown>"
        },
        "exact_rule_knowledge": {
          "const": "<none|suspected|known|unknown>"
        },
        "exact_variant_knowledge": {
          "const": "<none|suspected|known|unknown>"
        },
        "project_exposure": {
          "const": "<none|limited|substantial|unknown>"
        },
        "recognition_status": {
          "const": "<none|suspected|identified>"
        },
        "recognized_family": {
          "type": "null"
        },
        "recognized_work": {
          "type": "null"
        },
        "related_genre_experience": {
          "const": "<none|limited|extensive|unknown>"
        }
      },
      "required": [
        "exact_result_knowledge",
        "exact_rule_knowledge",
        "exact_variant_knowledge",
        "project_exposure",
        "recognition_status",
        "recognized_family",
        "recognized_work",
        "related_genre_experience"
      ],
      "type": "object"
    },
    "localId": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/localId"
    },
    "pollutionTemplate": {
      "additionalProperties": false,
      "properties": {
        "familiarity": {
          "$ref": "#/$defs/familiarityTemplate"
        },
        "integrity_exposures": {
          "maxItems": 0,
          "type": "array"
        },
        "stage_update_note": {
          "type": "null"
        }
      },
      "required": [
        "familiarity",
        "integrity_exposures",
        "stage_update_note"
      ],
      "type": "object"
    },
    "predictionAnswerTemplate": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "maxItems": 0,
          "type": "array"
        },
        "case_id": {
          "$ref": "#/$defs/caseId"
        },
        "compatible_alternatives": {
          "items": {
            "$ref": "#/$defs/predictionAlternativeTemplate"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "confidence_percent": {
          "const": -1
        },
        "expectations": {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "configuration_id": {
                    "const": "config.baseline"
                  }
                },
                "required": [
                  "configuration_id"
                ]
              },
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "configuration_id": {
                    "const": "config.variant"
                  }
                },
                "required": [
                  "configuration_id"
                ]
              },
              "minContains": 1
            }
          ],
          "items": {
            "$ref": "#/$defs/predictionExpectationTemplate"
          },
          "maxItems": 12,
          "minItems": 10,
          "type": "array",
          "uniqueItems": true
        },
        "prediction_status": {
          "const": "<determinate|indeterminate>"
        },
        "reasoning": {
          "const": "<required-explanation>"
        },
        "supporting_record_ids": {
          "maxItems": 0,
          "type": "array"
        }
      },
      "required": [
        "assumptions",
        "case_id",
        "compatible_alternatives",
        "confidence_percent",
        "expectations",
        "prediction_status",
        "reasoning",
        "supporting_record_ids"
      ],
      "type": "object"
    },
    "predictionAlternativeTemplate": {
      "additionalProperties": false,
      "properties": {
        "alternative_id": {
          "enum": [
            "<required-unique-local-id-1>",
            "<required-unique-local-id-2>"
          ]
        },
        "description": {
          "enum": [
            "<required-structure-description-1>",
            "<required-structure-description-2>"
          ]
        },
        "expectations": {
          "items": {
            "$ref": "#/$defs/predictionExpectationTemplate"
          },
          "maxItems": 12,
          "minItems": 10,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "alternative_id",
        "description",
        "expectations"
      ],
      "type": "object"
    },
    "predictionExpectationTemplate": {
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "enum": [
            "config.baseline",
            "config.variant"
          ]
        },
        "expectation_kind": {
          "const": "<direction|exact|set|status>"
        },
        "observation_id": {
          "$ref": "#/$defs/localId"
        },
        "tolerance_rule_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/localId"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "$ref": "#/$defs/predictionValueTemplate"
        }
      },
      "required": [
        "configuration_id",
        "expectation_kind",
        "observation_id",
        "tolerance_rule_id",
        "value"
      ],
      "type": "object"
    },
    "predictionPayloadTemplate": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/blind-response-interface-0.1.0.schema.json"
        },
        "artifact_type": {
          "const": "prediction_response_payload"
        },
        "artifact_version": {
          "const": "0.1.0"
        },
        "pollution": {
          "$ref": "#/$defs/pollutionTemplate"
        },
        "prediction_answers": {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "case_id": {
                    "const": "CA-R1"
                  }
                },
                "required": [
                  "case_id"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "case_id": {
                    "const": "CA-R2"
                  }
                },
                "required": [
                  "case_id"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "case_id": {
                    "const": "CA-R3"
                  }
                },
                "required": [
                  "case_id"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            }
          ],
          "items": {
            "$ref": "#/$defs/predictionAnswerTemplate"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "$schema",
        "artifact_type",
        "artifact_version",
        "pollution",
        "prediction_answers"
      ],
      "type": "object"
    },
    "predictionValueTemplate": {
      "additionalProperties": false,
      "properties": {
        "serialized_value": {
          "const": "<required-string>"
        },
        "unit": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_type": {
          "const": "<boolean|decimal|direction|id|id_set|integer|rational|status|string>"
        }
      },
      "required": [
        "serialized_value",
        "unit",
        "value_type"
      ],
      "type": "object"
    },
    "compatibleBranchTemplate": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "const": "<required-unique-local-id>"
        },
        "description": {
          "const": "<required-compatible-structure-description>"
        },
        "supporting_record_ids": {
          "maxItems": 0,
          "type": "array"
        }
      },
      "required": [
        "branch_id",
        "description",
        "supporting_record_ids"
      ],
      "type": "object"
    },
    "recoveredFactTemplate": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "const": "<required-fact-claim>"
        },
        "fact_id": {
          "const": "<required-unique-local-id>"
        },
        "recovery_status": {
          "const": "<inferred_with_assumption|not_recoverable|recovered>"
        },
        "supporting_record_ids": {
          "maxItems": 0,
          "type": "array"
        }
      },
      "required": [
        "claim",
        "fact_id",
        "recovery_status",
        "supporting_record_ids"
      ],
      "type": "object"
    },
    "reconstructionAnswerTemplate": {
      "additionalProperties": false,
      "properties": {
        "ambiguities": {
          "maxItems": 0,
          "type": "array"
        },
        "assumptions": {
          "maxItems": 0,
          "type": "array"
        },
        "case_id": {
          "$ref": "#/$defs/caseId"
        },
        "compatible_branches": {
          "items": {
            "$ref": "#/$defs/compatibleBranchTemplate"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "confidence_percent": {
          "const": -1
        },
        "recovered_facts": {
          "items": {
            "$ref": "#/$defs/recoveredFactTemplate"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "uniqueness": {
          "const": "<insufficient_information|multiple_compatible_structures|uniquely_recoverable>"
        }
      },
      "required": [
        "ambiguities",
        "assumptions",
        "case_id",
        "compatible_branches",
        "confidence_percent",
        "recovered_facts",
        "uniqueness"
      ],
      "type": "object"
    },
    "reconstructionPayloadTemplate": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/blind-response-interface-0.1.0.schema.json"
        },
        "artifact_type": {
          "const": "reconstruction_response_payload"
        },
        "artifact_version": {
          "const": "0.1.0"
        },
        "pollution": {
          "$ref": "#/$defs/pollutionTemplate"
        },
        "reconstruction_answers": {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "case_id": {
                    "const": "CA-R1"
                  }
                },
                "required": [
                  "case_id"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "case_id": {
                    "const": "CA-R2"
                  }
                },
                "required": [
                  "case_id"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "case_id": {
                    "const": "CA-R3"
                  }
                },
                "required": [
                  "case_id"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            }
          ],
          "items": {
            "$ref": "#/$defs/reconstructionAnswerTemplate"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "$schema",
        "artifact_type",
        "artifact_version",
        "pollution",
        "reconstruction_answers"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/response-template-0.1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "artifact_type": {
          "const": "prediction_response_template"
        },
        "stage": {
          "const": "prediction"
        },
        "template_payload": {
          "$ref": "#/$defs/predictionPayloadTemplate"
        }
      },
      "required": [
        "artifact_type",
        "stage",
        "template_payload"
      ]
    },
    {
      "properties": {
        "artifact_type": {
          "const": "reconstruction_response_template"
        },
        "stage": {
          "const": "reconstruction"
        },
        "template_payload": {
          "$ref": "#/$defs/reconstructionPayloadTemplate"
        }
      },
      "required": [
        "artifact_type",
        "stage",
        "template_payload"
      ]
    }
  ],
  "properties": {
    "$schema": {
      "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/response-template-0.1.0.schema.json"
    },
    "artifact_type": {
      "enum": [
        "prediction_response_template",
        "reconstruction_response_template"
      ]
    },
    "artifact_version": {
      "const": "0.1.0"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "run_id": {
      "pattern": "^continuous-[0-9]{3}$",
      "type": "string"
    },
    "stage": {
      "enum": [
        "prediction",
        "reconstruction"
      ]
    },
    "target_response_schema": {
      "$ref": "#/$defs/artifactReference"
    },
    "template_id": {
      "$ref": "#/$defs/localId"
    },
    "template_payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/predictionPayloadTemplate"
        },
        {
          "$ref": "#/$defs/reconstructionPayloadTemplate"
        }
      ]
    }
  },
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "created_at",
    "run_id",
    "stage",
    "target_response_schema",
    "template_id",
    "template_payload"
  ],
  "title": "Game Primitives Blind Response Template 0.1.0",
  "type": "object"
}
