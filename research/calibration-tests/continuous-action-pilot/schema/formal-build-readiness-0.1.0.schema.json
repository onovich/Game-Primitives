{
  "$defs": {
    "artifactReference": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/artifactReference"
    },
    "buildOutput": {
      "additionalProperties": false,
      "properties": {
        "output_id": {
          "$ref": "#/$defs/localId"
        },
        "repository_storage": {
          "const": false
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "output_id",
        "repository_storage",
        "sha256"
      ],
      "type": "object"
    },
    "caseReadiness": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "maxItems": 0,
          "type": "array"
        },
        "case_id": {
          "pattern": "^CA-R[1-3]$",
          "type": "string"
        },
        "configurations": {
          "allOf": [
            {
              "contains": {
                "properties": {
                  "configuration_id": {
                    "const": "config.baseline"
                  }
                },
                "required": [
                  "configuration_id"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            },
            {
              "contains": {
                "properties": {
                  "configuration_id": {
                    "const": "config.variant"
                  }
                },
                "required": [
                  "configuration_id"
                ]
              },
              "maxContains": 1,
              "minContains": 1
            }
          ],
          "items": {
            "$ref": "#/$defs/configurationReadiness"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "blockers",
        "case_id",
        "configurations",
        "source_commit",
        "status"
      ],
      "type": "object"
    },
    "configurationReadiness": {
      "additionalProperties": false,
      "properties": {
        "build_attempt_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "build_evidence_artifacts": {
          "items": {
            "$ref": "#/$defs/artifactReference"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "built_outputs": {
          "items": {
            "$ref": "#/$defs/buildOutput"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "configuration_id": {
          "enum": [
            "config.baseline",
            "config.variant"
          ]
        },
        "fixture_artifacts": {
          "items": {
            "$ref": "#/$defs/artifactReference"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "formal_input_executed": {
          "const": false
        },
        "formal_result_produced": {
          "const": false
        },
        "realization": {
          "enum": [
            "separate_binary",
            "shared_binary_configuration"
          ]
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "build_attempt_ids",
        "build_evidence_artifacts",
        "built_outputs",
        "configuration_id",
        "fixture_artifacts",
        "formal_input_executed",
        "formal_result_produced",
        "realization",
        "status"
      ],
      "type": "object"
    },
    "localId": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/localId"
    },
    "sha256": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/sha256"
    }
  },
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/formal-build-readiness-0.1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/formal-build-readiness-0.1.0.schema.json"
    },
    "artifact_type": {
      "const": "formal_build_readiness"
    },
    "artifact_version": {
      "const": "0.1.0"
    },
    "assessed_at": {
      "format": "date-time",
      "type": "string"
    },
    "cases": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "case_id": {
                "const": "CA-R1"
              }
            },
            "required": [
              "case_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "case_id": {
                "const": "CA-R2"
              }
            },
            "required": [
              "case_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "case_id": {
                "const": "CA-R3"
              }
            },
            "required": [
              "case_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/caseReadiness"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "evidence_artifacts": {
      "items": {
        "$ref": "#/$defs/artifactReference"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "formal_input_executed": {
      "const": false
    },
    "formal_result_produced": {
      "const": false
    },
    "overall_status": {
      "const": "passed"
    },
    "readiness_scope": {
      "const": "build_only"
    },
    "run_id": {
      "const": "continuous-001"
    },
    "supersedes_probe": {
      "$ref": "#/$defs/artifactReference"
    }
  },
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "assessed_at",
    "cases",
    "evidence_artifacts",
    "formal_input_executed",
    "formal_result_produced",
    "overall_status",
    "readiness_scope",
    "run_id",
    "supersedes_probe"
  ],
  "title": "Game Primitives Formal Build Readiness 0.1.0",
  "type": "object"
}
