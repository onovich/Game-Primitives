{
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/execution-artifact-0.1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/localId"
        },
        "path": {
          "minLength": 1,
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "caseExecutionPlan": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/caseId"
        },
        "comparators": {
          "items": {
            "$ref": "#/$defs/comparator"
          },
          "minItems": 1,
          "type": "array"
        },
        "configurations": {
          "items": {
            "$ref": "#/$defs/executionConfiguration"
          },
          "minItems": 2,
          "type": "array"
        },
        "environment_refs": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "formal_input": {
          "$ref": "#/$defs/artifactReference"
        },
        "invariants": {
          "items": {
            "$ref": "#/$defs/invariantSpec"
          },
          "minItems": 1,
          "type": "array"
        },
        "negative_control": {
          "type": "boolean"
        },
        "repetition_count": {
          "minimum": 2,
          "type": "integer"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "stop_boundary_id": {
          "$ref": "#/$defs/localId"
        },
        "time_base_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "case_id",
        "comparators",
        "configurations",
        "environment_refs",
        "formal_input",
        "invariants",
        "negative_control",
        "repetition_count",
        "source_commit",
        "stop_boundary_id",
        "time_base_ids"
      ],
      "type": "object"
    },
    "caseId": {
      "pattern": "^(?:CA-R[1-3]|NEG-01)$",
      "type": "string"
    },
    "caseResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/caseId"
        },
        "comparison_records": {
          "items": {
            "$ref": "#/$defs/comparisonRecord"
          },
          "type": "array"
        },
        "execution_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "execution_status": {
          "enum": [
            "completed",
            "invalid",
            "not_evaluable"
          ]
        },
        "invariant_results": {
          "items": {
            "$ref": "#/$defs/invariantResult"
          },
          "type": "array"
        },
        "negative_control_result": {
          "oneOf": [
            {
              "enum": [
                "failed",
                "invalid",
                "not_evaluable",
                "passed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/observedValue"
          },
          "type": "array"
        },
        "repeat_consistency": {
          "enum": [
            "consistent",
            "inconsistent",
            "not_evaluable"
          ]
        }
      },
      "required": [
        "case_id",
        "comparison_records",
        "execution_ids",
        "execution_status",
        "invariant_results",
        "negative_control_result",
        "observations",
        "repeat_consistency"
      ],
      "type": "object"
    },
    "comparator": {
      "additionalProperties": false,
      "properties": {
        "allowed_observation_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "comparator_id": {
          "$ref": "#/$defs/localId"
        },
        "implementation": {
          "$ref": "#/$defs/artifactReference"
        },
        "tolerance_rules": {
          "items": {
            "$ref": "#/$defs/toleranceRule"
          },
          "type": "array"
        }
      },
      "required": [
        "allowed_observation_ids",
        "comparator_id",
        "implementation",
        "tolerance_rules"
      ],
      "type": "object"
    },
    "comparisonRecord": {
      "additionalProperties": false,
      "properties": {
        "comparator_id": {
          "$ref": "#/$defs/localId"
        },
        "evidence_observation_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "result": {
          "enum": [
            "different",
            "equal",
            "not_evaluable",
            "outside_tolerance",
            "within_tolerance"
          ]
        }
      },
      "required": [
        "comparator_id",
        "evidence_observation_ids",
        "result"
      ],
      "type": "object"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "environment_id": {
          "$ref": "#/$defs/localId"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "name",
        "platform",
        "version"
      ],
      "type": "object"
    },
    "executionArtifact": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "artifact_type": {
          "enum": [
            "execution_plan",
            "execution_result",
            "trace_bundle"
          ]
        },
        "artifact_version": {
          "const": "0.1.0"
        },
        "case_results": {
          "items": {
            "$ref": "#/$defs/caseResult"
          },
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/caseExecutionPlan"
          },
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "environments": {
          "items": {
            "$ref": "#/$defs/environment"
          },
          "type": "array"
        },
        "executions": {
          "items": {
            "$ref": "#/$defs/executionTrace"
          },
          "type": "array"
        },
        "execution_plan_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at": {
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture_lock": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "prediction_set_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "run_id": {
          "pattern": "^(?:continuous|rehearsal)-[0-9]{3}$",
          "type": "string"
        },
        "started_at": {
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace_bundle_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "$schema",
        "artifact_type",
        "artifact_version",
        "case_results",
        "cases",
        "created_at",
        "environments",
        "executions",
        "execution_plan_sha256",
        "finished_at",
        "fixture_lock",
        "prediction_set_digest",
        "protocol_version",
        "run_id",
        "started_at",
        "trace_bundle_sha256"
      ],
      "type": "object"
    },
    "executionConfiguration": {
      "additionalProperties": false,
      "properties": {
        "build_command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "configuration_id": {
          "$ref": "#/$defs/localId"
        },
        "expected_binary_path": {
          "minLength": 1,
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "type": "string"
        },
        "fixture_artifacts": {
          "items": {
            "$ref": "#/$defs/artifactReference"
          },
          "minItems": 1,
          "type": "array"
        },
        "run_command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "semantic_role": {
          "enum": [
            "baseline",
            "negative_control_a",
            "negative_control_b",
            "variant"
          ]
        }
      },
      "required": [
        "build_command",
        "configuration_id",
        "expected_binary_path",
        "fixture_artifacts",
        "run_command",
        "semantic_role"
      ],
      "type": "object"
    },
    "executionTrace": {
      "additionalProperties": false,
      "properties": {
        "binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "case_id": {
          "$ref": "#/$defs/caseId"
        },
        "configuration_id": {
          "$ref": "#/$defs/localId"
        },
        "environment_id": {
          "$ref": "#/$defs/localId"
        },
        "execution_id": {
          "$ref": "#/$defs/localId"
        },
        "finished_at": {
          "format": "date-time",
          "type": "string"
        },
        "process_exit_code": {
          "type": "integer"
        },
        "repetition_index": {
          "minimum": 1,
          "type": "integer"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "trace_entries": {
          "items": {
            "$ref": "#/$defs/traceEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "binary_sha256",
        "case_id",
        "configuration_id",
        "environment_id",
        "execution_id",
        "finished_at",
        "process_exit_code",
        "repetition_index",
        "started_at",
        "trace_entries"
      ],
      "type": "object"
    },
    "invariantResult": {
      "additionalProperties": false,
      "properties": {
        "evidence_observation_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "invariant_id": {
          "$ref": "#/$defs/localId"
        },
        "status": {
          "enum": [
            "held",
            "not_evaluable",
            "violated"
          ]
        }
      },
      "required": [
        "evidence_observation_ids",
        "invariant_id",
        "status"
      ],
      "type": "object"
    },
    "invariantSpec": {
      "additionalProperties": false,
      "properties": {
        "comparator_id": {
          "$ref": "#/$defs/localId"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "invariant_id": {
          "$ref": "#/$defs/localId"
        },
        "observation_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "comparator_id",
        "description",
        "invariant_id",
        "observation_ids"
      ],
      "type": "object"
    },
    "localId": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "observedValue": {
      "additionalProperties": false,
      "properties": {
        "configuration_id": {
          "$ref": "#/$defs/localId"
        },
        "execution_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "observation_id": {
          "$ref": "#/$defs/localId"
        },
        "value": {
          "$ref": "#/$defs/typedValue"
        }
      },
      "required": [
        "configuration_id",
        "execution_ids",
        "observation_id",
        "value"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "timeMark": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "pattern": "^[1-9][0-9]*$",
          "type": "string"
        },
        "numerator": {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        "time_base_id": {
          "$ref": "#/$defs/localId"
        }
      },
      "required": [
        "denominator",
        "numerator",
        "time_base_id"
      ],
      "type": "object"
    },
    "toleranceRule": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "enum": [
            "absolute",
            "exact",
            "relative",
            "set_equality"
          ]
        },
        "observation_id": {
          "$ref": "#/$defs/localId"
        },
        "tolerance_rule_id": {
          "$ref": "#/$defs/localId"
        },
        "value": {
          "$ref": "#/$defs/typedValue"
        }
      },
      "required": [
        "comparison",
        "observation_id",
        "tolerance_rule_id",
        "value"
      ],
      "type": "object"
    },
    "traceEntry": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "field_id": {
                "$ref": "#/$defs/localId"
              },
              "value": {
                "$ref": "#/$defs/typedValue"
              }
            },
            "required": [
              "field_id",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "kind": {
          "enum": [
            "action_legality_evaluated",
            "candidate_occurrence",
            "effect_committed",
            "feedback_available",
            "feedback_withdrawn",
            "formal_event_recorded",
            "input_arrived",
            "input_buffered",
            "input_expired",
            "input_recognized",
            "input_sampled",
            "lifecycle_milestone_reached",
            "permission_changed",
            "process_update",
            "resolution_completed",
            "scope_ended",
            "scope_started",
            "state_committed",
            "state_sampled"
          ]
        },
        "provenance_kind": {
          "enum": [
            "instrument_measurement",
            "rule_derivation",
            "source_record"
          ]
        },
        "provenance_locator_id": {
          "$ref": "#/$defs/localId"
        },
        "serialization_ordinal": {
          "minimum": 0,
          "type": "integer"
        },
        "structure_record_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "subject_ids": {
          "items": {
            "$ref": "#/$defs/localId"
          },
          "minItems": 1,
          "type": "array"
        },
        "time_marks": {
          "items": {
            "$ref": "#/$defs/timeMark"
          },
          "minItems": 1,
          "type": "array"
        },
        "trace_entry_id": {
          "$ref": "#/$defs/localId"
        }
      },
      "required": [
        "fields",
        "kind",
        "provenance_kind",
        "provenance_locator_id",
        "serialization_ordinal",
        "structure_record_ids",
        "subject_ids",
        "time_marks",
        "trace_entry_id"
      ],
      "type": "object"
    },
    "typedValue": {
      "additionalProperties": false,
      "properties": {
        "serialized_value": {
          "type": "string"
        },
        "unit": {
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "value_type": {
          "enum": [
            "boolean",
            "decimal",
            "direction",
            "id",
            "id_set",
            "integer",
            "rational",
            "status",
            "string"
          ]
        }
      },
      "required": [
        "serialized_value",
        "unit",
        "value_type"
      ],
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "artifact_type": {
          "const": "execution_plan"
        },
        "execution_plan_sha256": {
          "type": "null"
        },
        "finished_at": {
          "type": "null"
        },
        "prediction_set_digest": {
          "type": "null"
        },
        "started_at": {
          "type": "null"
        },
        "trace_bundle_sha256": {
          "type": "null"
        }
      },
      "required": [
        "artifact_type",
        "cases",
        "environments",
        "fixture_lock"
      ]
    },
    {
      "properties": {
        "artifact_type": {
          "const": "execution_result"
        }
      },
      "required": [
        "artifact_type",
        "case_results",
        "execution_plan_sha256",
        "finished_at",
        "prediction_set_digest",
        "started_at",
        "trace_bundle_sha256"
      ]
    },
    {
      "properties": {
        "artifact_type": {
          "const": "trace_bundle"
        }
      },
      "required": [
        "artifact_type",
        "execution_plan_sha256",
        "executions",
        "finished_at",
        "prediction_set_digest",
        "started_at"
      ]
    }
  ],
  "title": "Game Primitives Continuous Action Execution Artifacts 0.1.0",
  "type": "object",
  "$ref": "#/$defs/executionArtifact"
}
