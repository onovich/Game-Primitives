  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/formal-human-gate-authorization-0.1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "authorization_context": {
            "const": "formal_run"
          }
        },
        "required": [
          "authorization_context"
        ]
      },
      "then": {
        "properties": {
          "authorization_basis": {
            "properties": {
              "decision": {
                "const": "authorized"
              },
              "source_kind": {
                "const": "explicit_user_message"
              }
            }
          },
          "authorization_id": {
            "const": "authorization.continuous-002.human-gate"
          },
          "authorization_phrase": {
            "const": "RUN_CONTINUOUS_002_FORMAL"
          },
          "authorization_scopes": {
            "properties": {
              "blind_dispatch_authorized": {
                "const": true
              },
              "formal_execution_after_prediction_freeze_authorized": {
                "const": true
              },
              "synthetic_receipt_materialization_authorized": {
                "const": false
              }
            }
          },
          "authorization_state": {
            "const": "authorized"
          },
          "authorized_by": {
            "properties": {
              "role": {
                "const": "author"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authorization_context": {
            "const": "synthetic_self_test"
          }
        },
        "required": [
          "authorization_context"
        ]
      },
      "then": {
        "properties": {
          "authorization_basis": {
            "properties": {
              "decision": {
                "const": "synthetic_only"
              },
              "source_kind": {
                "const": "synthetic_self_test"
              }
            }
          },
          "authorization_id": {
            "const": "authorization.continuous-002.synthetic-self-test"
          },
          "authorization_phrase": {
            "const": "SYNTHETIC_SELF_TEST_ONLY_DO_NOT_DISPATCH_OR_EXECUTE"
          },
          "authorization_scopes": {
            "properties": {
              "blind_dispatch_authorized": {
                "const": false
              },
              "formal_execution_after_prediction_freeze_authorized": {
                "const": false
              },
              "synthetic_receipt_materialization_authorized": {
                "const": true
              }
            }
          },
          "authorization_state": {
            "const": "synthetic_only"
          },
          "authorized_by": {
            "properties": {
              "role": {
                "const": "self_test_harness"
              }
            }
          }
        }
      }
    }
  ],
