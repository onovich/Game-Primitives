        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "nonce_length_bytes": {
          "const": 32
        },
        "truth_bundle_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "truth_bundle_name": {
          "const": "sealed-truth.json"
