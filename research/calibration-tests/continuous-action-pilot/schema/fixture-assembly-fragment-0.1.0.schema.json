{
  "$defs": {
    "artifactReference": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/artifactReference"
    }
  },
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/fixture-assembly-fragment-0.1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/fixture-assembly-fragment-0.1.0.schema.json"
    },
    "artifact_type": {
      "const": "fixture_assembly_fragment"
    },
    "artifact_version": {
      "const": "0.1.0"
    },
    "build_readiness": {
      "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/formal-build-readiness-0.1.0.schema.json#/$defs/caseReadiness"
    },
    "build_readiness_evidence_artifacts": {
      "items": {
        "$ref": "#/$defs/artifactReference"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "case_id": {
      "pattern": "^CA-R[1-3]$",
      "type": "string"
    },
    "fixture_lock_case_json_pointer": {
      "enum": [
        "",
        "/case_lock"
      ]
    },
    "fixture_lock_case_source": {
      "$ref": "#/$defs/artifactReference"
    },
    "formal_input_executed": {
      "const": false
    },
    "formal_result_produced": {
      "const": false
    },
    "negative_control_artifacts": {
      "items": {
        "$ref": "#/$defs/artifactReference"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "prepared_at": {
      "format": "date-time",
      "type": "string"
    },
    "run_id": {
      "const": "continuous-001"
    },
    "structured_build_evidence": {
      "$ref": "#/$defs/artifactReference"
    },
    "supersedes_probe": {
      "$ref": "#/$defs/artifactReference"
    }
  },
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "build_readiness",
    "build_readiness_evidence_artifacts",
    "case_id",
    "fixture_lock_case_json_pointer",
    "fixture_lock_case_source",
    "formal_input_executed",
    "formal_result_produced",
    "negative_control_artifacts",
    "prepared_at",
    "run_id",
    "structured_build_evidence",
    "supersedes_probe"
  ],
  "title": "Game Primitives Fixture Assembly Fragment 0.1.0",
  "type": "object"
}
