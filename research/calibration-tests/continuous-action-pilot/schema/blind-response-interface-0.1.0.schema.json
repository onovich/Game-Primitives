          "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/blind-response-interface-0.1.0.schema.json"
        },
        "artifact_type": {
          "const": "reconstruction_response_payload"
        },
        "artifact_version": {
          "const": "0.1.0"
        },
        "pollution": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/role-submission-0.1.1.schema.json#/$defs/pollution"
        },
        "reconstruction_answers": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/reconstructionAnswerR1"
              },
              {
                "$ref": "#/$defs/reconstructionAnswerR2"
              },
              {
                "$ref": "#/$defs/reconstructionAnswerR3"
              }
            ]
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {
                "$ref": "#/$defs/reconstructionAnswerR1"
              },
              "maxContains": 1,
              "minContains": 1
            },
            {
              "contains": {
                "$ref": "#/$defs/reconstructionAnswerR2"
              },
              "maxContains": 1,
              "minContains": 1
            },
            {
              "contains": {
                "$ref": "#/$defs/reconstructionAnswerR3"
              },
              "maxContains": 1,
              "minContains": 1
            }
          ]
        }
      },
      "required": [
        "$schema",
        "artifact_type",
        "artifact_version",
        "pollution",
        "reconstruction_answers"
      ],
      "type": "object"
    },
    "reconstructionAnswerR1": {
      "$ref": "#/$defs/reconstructionAnswer",
      "properties": {
        "case_id": {
          "const": "CA-R1"
        }
      }
    },
    "reconstructionAnswerR2": {
      "$ref": "#/$defs/reconstructionAnswer",
      "properties": {
        "case_id": {
          "const": "CA-R2"
        }
      }
    },
    "reconstructionAnswerR3": {
      "$ref": "#/$defs/reconstructionAnswer",
      "properties": {
        "case_id": {
          "const": "CA-R3"
        }
      }
    },
    "submissionEnvelope": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "reconstruction"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "prior_stage_submission_sha256": {
                "type": "null"
              },
              "target_artifact_type": {
                "const": "reconstruction_submission"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "prediction"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "prior_stage_submission_sha256": {
                "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/role-submission-0.1.1.schema.json#/$defs/sha256"
              },
              "target_artifact_type": {
                "const": "prediction_submission"
              }
            }
          }
        }
      ],
      "properties": {
        "$schema": {
          "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/blind-response-interface-0.1.0.schema.json"
        },
        "actor": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/role-submission-0.1.1.schema.json#/$defs/testActor"
        },
        "artifact_type": {
          "const": "role_submission_envelope"
        },
        "artifact_version": {
          "const": "0.1.0"
        },
        "condition_id": {
          "pattern": "^condition-v0[12]$",
          "type": "string"
        },
        "dispatch_artifacts": {
          "items": {
            "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/role-submission-0.1.1.schema.json#/$defs/artifactReference"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "first_submission": {
          "const": true
        },
        "output_schema": {
          "$ref": "#/$defs/dispatchReference"
        },
        "packager": {
          "$ref": "#/$defs/dispatchReference"
        },
        "prior_stage_submission_sha256": {
          "oneOf": [
            {
              "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/role-submission-0.1.1.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at": {
          "format": "date-time",
          "type": "string"
        },
        "response_schema": {
          "$ref": "#/$defs/dispatchReference"
        },
        "run_id": {
          "pattern": "^(?:continuous|rehearsal)-[0-9]{3}$",
          "type": "string"
        },
        "stage": {
          "enum": [
            "prediction",
            "reconstruction"
          ]
        },
        "submission_id": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/role-submission-0.1.1.schema.json#/$defs/localId"
        },
        "target_artifact_type": {
          "enum": [
            "prediction_submission",
            "reconstruction_submission"
          ]
        },
        "target_artifact_version": {
          "const": "0.1.2"
        },
        "task_id": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/role-submission-0.1.1.schema.json#/$defs/localId"
        }
      },
      "required": [
        "$schema",
        "actor",
        "artifact_type",
        "artifact_version",
        "condition_id",
        "dispatch_artifacts",
        "first_submission",
        "output_schema",
        "packager",
        "prior_stage_submission_sha256",
        "received_at",
        "response_schema",
        "run_id",
        "stage",
        "submission_id",
        "target_artifact_type",
        "target_artifact_version",
        "task_id"
      ],
      "type": "object"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/predictionPayload"
    },
    {
      "$ref": "#/$defs/reconstructionPayload"
    },
    {
      "$ref": "#/$defs/submissionEnvelope"
    }
  ],
  "title": "Game Primitives Blind Response Interface 0.1.0"
}
