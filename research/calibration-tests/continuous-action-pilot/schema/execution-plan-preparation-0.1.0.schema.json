{
  "$defs": {
    "artifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          },
          "pattern": "^research/calibration-tests/continuous-action-pilot/[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "blocker": {
      "additionalProperties": false,
      "properties": {
        "blocked_operation": {
          "const": "formal_build_readiness"
        },
        "blocker_id": {
          "const": "r1.legal-unity-license-activation"
        },
        "blocker_kind": {
          "const": "legal_license_activation"
        },
        "must_not_bypass": {
          "const": true
        },
        "resolution_required": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "const": "open"
        }
      },
      "required": [
        "blocked_operation",
        "blocker_id",
        "blocker_kind",
        "must_not_bypass",
        "resolution_required",
        "status"
      ],
      "type": "object"
    },
    "casePreparation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "case_id": {
                "const": "CA-R1"
              }
            },
            "required": [
              "case_id"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "items": {
                  "$ref": "#/$defs/blocker"
                },
                "maxItems": 1,
                "minItems": 1
              },
              "preparation_status": {
                "const": "blocked"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_id": {
                "enum": [
                  "CA-R2",
                  "CA-R3"
                ]
              }
            },
            "required": [
              "case_id"
            ]
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              },
              "preparation_status": {
                "const": "candidate_ready"
              }
            }
          }
        }
      ],
      "properties": {
        "blockers": {
          "items": {
            "$ref": "#/$defs/blocker"
          },
          "type": "array"
        },
        "case_id": {
          "enum": [
            "CA-R1",
            "CA-R2",
            "CA-R3"
          ]
        },
        "comparator": {
          "$ref": "#/$defs/artifactReference"
        },
        "final_fixture_lock_included": {
          "const": false
        },
        "formal_execution_allowed": {
          "const": false
        },
        "formal_input_reference_state": {
          "const": "not_embedded_in_preparation_plan"
        },
        "formal_runner": {
          "$ref": "#/$defs/artifactReference"
        },
        "preparation_evidence": {
          "$ref": "#/$defs/artifactReference"
        },
        "preparation_status": {
          "enum": [
            "blocked",
            "candidate_ready"
          ]
        },
        "raw_trace_schema": {
          "$ref": "#/$defs/artifactReference"
        }
      },
      "required": [
        "blockers",
        "case_id",
        "comparator",
        "final_fixture_lock_included",
        "formal_execution_allowed",
        "formal_input_reference_state",
        "formal_runner",
        "preparation_evidence",
        "preparation_status",
        "raw_trace_schema"
      ],
      "type": "object"
    },
    "executionState": {
      "additionalProperties": false,
      "properties": {
        "formal_comparator_started": {
          "const": false
        },
        "formal_execution_permit_created": {
          "const": false
        },
        "formal_fixture_started": {
          "const": false
        },
        "formal_input_content_embedded_in_plan": {
          "const": false
        },
        "formal_input_executed": {
          "const": false
        },
        "formal_result_created": {
          "const": false
        },
        "human_gate_authorization_created": {
          "const": false
        },
        "prediction_set_created": {
          "const": false
        },
        "truth_commitment_created": {
          "const": false
        }
      },
      "required": [
        "formal_comparator_started",
        "formal_execution_permit_created",
        "formal_fixture_started",
        "formal_input_content_embedded_in_plan",
        "formal_input_executed",
        "formal_result_created",
        "human_gate_authorization_created",
        "prediction_set_created",
        "truth_commitment_created"
      ],
      "type": "object"
    },
    "gatePolicy": {
      "additionalProperties": false,
      "properties": {
        "final_plan_required_before_human_gate": {
          "const": true
        },
        "formal_execution_authorized": {
          "const": false
        },
        "formal_execution_only_after_gate": {
          "const": true
        },
        "human_gate_state": {
          "const": "withheld"
        },
        "planned_human_gate_count": {
          "const": 1
        },
        "prediction_freeze_required_before_execution": {
          "const": true
        },
        "required_before_blind_dispatch": {
          "const": true
        },
        "verified_execution_permit_required": {
          "const": true
        }
      },
      "required": [
        "final_plan_required_before_human_gate",
        "formal_execution_authorized",
        "formal_execution_only_after_gate",
        "human_gate_state",
        "planned_human_gate_count",
        "prediction_freeze_required_before_execution",
        "required_before_blind_dispatch",
        "verified_execution_permit_required"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/execution-plan-preparation-0.1.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/execution-plan-preparation-0.1.0.schema.json"
    },
    "artifact_type": {
      "const": "execution_plan_preparation"
    },
    "artifact_version": {
      "const": "0.1.0"
    },
    "case_preparations": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "case_id": {
                "const": "CA-R1"
              }
            },
            "required": [
              "case_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "case_id": {
                "const": "CA-R2"
              }
            },
            "required": [
              "case_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "case_id": {
                "const": "CA-R3"
              }
            },
            "required": [
              "case_id"
            ]
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/casePreparation"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "execution_sequence": {
      "const": [
        "resolve_pre_gate_blockers",
        "finalize_build_readiness",
        "finalize_fixture_lock",
        "replace_with_final_execution_plan",
        "complete_projection_audit_and_freeze",
        "pass_single_human_gate",
        "complete_blind_dispatch_and_freeze_predictions",
        "materialize_and_verify_execution_permit",
        "execute_formal_fixtures",
        "verify_raw_traces",
        "compare_formal_traces"
      ]
    },
    "execution_state": {
      "$ref": "#/$defs/executionState"
    },
    "final_plan_state": {
      "const": "awaiting_fixture_lock"
    },
    "finalization_requirements": {
      "const": [
        "resolve_r1_legal_license_blocker",
        "pass_r1_build_only_readiness",
        "produce_all_case_formal_build_readiness",
        "produce_final_fixture_lock",
        "replace_this_artifact_with_final_execution_plan",
        "pass_projection_audit",
        "freeze_two_commits_before_human_gate"
      ]
    },
    "formal_build_readiness_state": {
      "const": "blocked"
    },
    "gate_policy": {
      "$ref": "#/$defs/gatePolicy"
    },
    "global_blocker_ids": {
      "const": [
        "r1.legal-unity-license-activation"
      ]
    },
    "guard_artifacts": {
      "items": {
        "$ref": "#/$defs/artifactReference"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "not_a_final_execution_plan": {
      "const": true
    },
    "plan_status": {
      "const": "blocked_pre_gate"
    },
    "run_id": {
      "const": "continuous-001"
    },
    "successor_plan_schema": {
      "$ref": "#/$defs/artifactReference"
    }
  },
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "case_preparations",
    "created_at",
    "execution_sequence",
    "execution_state",
    "final_plan_state",
    "finalization_requirements",
    "formal_build_readiness_state",
    "gate_policy",
    "global_blocker_ids",
    "guard_artifacts",
    "not_a_final_execution_plan",
    "plan_status",
    "run_id",
    "successor_plan_schema"
  ],
  "title": "Game Primitives Continuous Action Execution Plan Preparation 0.1.0",
  "type": "object"
}
