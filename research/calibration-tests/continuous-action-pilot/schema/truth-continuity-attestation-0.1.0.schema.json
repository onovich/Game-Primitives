      "additionalProperties": false,
      "properties": {
        "materializer": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactReference"
            },
            {
              "properties": {
                "path": {
                  "const": "research/calibration-tests/continuous-action-pilot/tools/materialize-truth-continuity-attestation-v0.1.0.py"
