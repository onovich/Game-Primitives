        "description": {
          "maxLength": 240,
          "minLength": 12,
          "pattern": "^(?!.*(?:[Rr][Ii][Cc][Hh]|[Aa][Tt][Oo][Mm][Ii][Cc])).+$",
          "type": "string"
        },
        "invariant_id": {
          "$ref": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/task-packet-0.1.0.schema.json#/$defs/localId"
        }
      },
      "required": [
        "description",
        "invariant_id"
      ],
      "type": "object"
    },
