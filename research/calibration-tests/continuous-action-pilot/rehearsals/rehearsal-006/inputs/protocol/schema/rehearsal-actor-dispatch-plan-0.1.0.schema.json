              "$ref": "#/$defs/promptReference"
            },
            {
              "properties": {
                "path": {
                  "const": "research/calibration-tests/continuous-action-pilot/rehearsals/rehearsal-006/inputs/dispatch/stage2-neutral.prompt.txt"
                }
              }
            }
          ]
        }
