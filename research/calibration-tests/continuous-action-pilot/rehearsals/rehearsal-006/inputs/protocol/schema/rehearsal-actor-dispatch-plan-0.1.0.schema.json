      "required": [
        "actor_id",
        "condition_id",
        "directory_name",
        "stage1_prompt",
        "stage2_prompt"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
