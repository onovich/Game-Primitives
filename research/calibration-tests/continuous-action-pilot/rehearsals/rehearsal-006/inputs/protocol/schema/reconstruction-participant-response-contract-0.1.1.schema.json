{
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/reconstruction-participant-response-contract-0.1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "artifactBinding": {
      "additionalProperties": false,
      "properties": {
        "schema_id": {
          "format": "uri",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_id",
        "sha256"
      ],
      "type": "object"
    },
    "integrityExposureShape": {
      "additionalProperties": false,
      "properties": {
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "minProperties": 7,
          "type": "object"
        },
        "required": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 7,
          "type": "array",
          "uniqueItems": true
        },
        "type": {
          "const": "object"
        }
      },
      "required": [
        "additionalProperties",
        "properties",
        "required",
        "type"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "stringEnum": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "stringFieldList": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "reconstruction_participant_response_contract"
    },
    "artifact_version": {
      "const": "0.1.1"
    },
    "confidence_percent_rule": {
      "const": {
        "maximum": 100,
        "minimum": 0,
        "template_slot": "<integer-0-100>",
        "type": "integer"
      }
    },
    "integrity_exposure_item_shape": {
      "$ref": "#/$defs/integrityExposureShape"
    },
    "local_id_pattern": {
      "minLength": 1,
      "type": "string"
    },
    "pollution_enums": {
      "additionalProperties": false,
      "properties": {
        "exact_result_knowledge": {
          "$ref": "#/$defs/stringEnum"
        },
        "exact_rule_knowledge": {
          "$ref": "#/$defs/stringEnum"
        },
        "exact_variant_knowledge": {
          "$ref": "#/$defs/stringEnum"
        },
        "integrity_exposure_type": {
          "$ref": "#/$defs/stringEnum"
        },
        "integrity_stage": {
          "$ref": "#/$defs/stringEnum"
        },
        "integrity_status": {
          "$ref": "#/$defs/stringEnum"
        },
        "project_exposure": {
          "$ref": "#/$defs/stringEnum"
        },
        "recognition_status": {
          "$ref": "#/$defs/stringEnum"
        },
        "related_genre_experience": {
          "$ref": "#/$defs/stringEnum"
        }
      },
      "required": [
        "exact_result_knowledge",
        "exact_rule_knowledge",
        "exact_variant_knowledge",
        "integrity_exposure_type",
        "integrity_stage",
        "integrity_status",
        "project_exposure",
        "recognition_status",
        "related_genre_experience"
      ],
      "type": "object"
    },
    "reconstruction_rules": {
      "additionalProperties": false,
      "properties": {
        "case_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "case_occurrence": {
          "const": "exactly_once"
        },
        "local_id_fields": {
          "const": [
            "compatible_branches[].branch_id",
            "recovered_facts[].fact_id",
            "supporting_record_ids[]"
          ]
        },
        "uniqueness_values": {
          "$ref": "#/$defs/stringEnum"
        }
      },
      "required": [
        "case_ids",
        "case_occurrence",
        "local_id_fields",
        "uniqueness_values"
      ],
      "type": "object"
    },
    "required_fields": {
      "additionalProperties": false,
      "properties": {
        "compatible_branch": {
          "$ref": "#/$defs/stringFieldList"
        },
        "familiarity": {
          "$ref": "#/$defs/stringFieldList"
        },
        "integrity_exposure": {
          "$ref": "#/$defs/stringFieldList"
        },
        "pollution": {
          "$ref": "#/$defs/stringFieldList"
        },
        "reconstruction_answer": {
          "$ref": "#/$defs/stringFieldList"
        },
        "reconstruction_payload": {
          "$ref": "#/$defs/stringFieldList"
        },
        "recovered_fact": {
          "$ref": "#/$defs/stringFieldList"
        }
      },
      "required": [
        "compatible_branch",
        "familiarity",
        "integrity_exposure",
        "pollution",
        "reconstruction_answer",
        "reconstruction_payload",
        "recovered_fact"
      ],
      "type": "object"
    },
    "source_bindings": {
      "additionalProperties": false,
      "properties": {
        "response_schema": {
          "$ref": "#/$defs/artifactBinding"
        },
        "role_schema": {
          "$ref": "#/$defs/artifactBinding"
        },
        "run_id": {
          "pattern": "^(?:continuous|rehearsal)-[0-9]{3}$",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "response_schema",
        "role_schema",
        "run_id",
        "task_id"
      ],
      "type": "object"
    },
    "stage": {
      "const": "reconstruction"
    },
    "template_choice_semantics": {
      "additionalProperties": false,
      "properties": {
        "choice_placeholder_pattern": {
          "const": "^<[^<>]+>$"
        },
        "frozen_value_rule": {
          "const": "non_placeholder_values_are_frozen_except_declared_mutable_arrays"
        },
        "mutable_array_rules": {
          "const": [
            {
              "array": "pollution.integrity_exposures",
              "allowed_action": "keep_empty_or_append_schema_valid_items"
            },
            {
              "array": "reconstruction_answers[].ambiguities",
              "allowed_action": "keep_empty_or_append_nonempty_strings"
            },
            {
              "array": "reconstruction_answers[].assumptions",
              "allowed_action": "keep_empty_or_append_nonempty_strings"
            },
            {
              "array": "reconstruction_answers[].compatible_branches",
              "allowed_action": "clear_retain_or_expand_complete_items"
            },
            {
              "array": "reconstruction_answers[].recovered_facts",
              "allowed_action": "clear_retain_or_expand_complete_items"
            },
            {
              "array": "supporting_record_ids",
              "allowed_action": "keep_empty_or_append_valid_local_ids"
            }
          ]
        },
        "template_kind": {
          "const": "typed_choice_template"
        }
      },
      "required": [
        "choice_placeholder_pattern",
        "frozen_value_rule",
        "mutable_array_rules",
        "template_kind"
      ],
      "type": "object"
    }
  },
  "required": [
    "artifact_type",
    "artifact_version",
    "confidence_percent_rule",
    "integrity_exposure_item_shape",
    "local_id_pattern",
    "pollution_enums",
    "reconstruction_rules",
    "required_fields",
    "source_bindings",
    "stage",
    "template_choice_semantics"
  ],
  "title": "Game Primitives Reconstruction Participant Response Contract 0.1.1",
  "type": "object"
}
