{
  "$id": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/prediction-template-contract-check-0.1.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "issue_count": {
            "const": 0
          },
          "issues": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "issue_count": {
            "minimum": 1
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "$schema": {
      "const": "https://github.com/onovich/Game-Primitives/blob/main/research/calibration-tests/continuous-action-pilot/schema/prediction-template-contract-check-0.1.1.schema.json"
    },
    "artifact_type": {
      "const": "prediction_template_contract_check"
    },
    "artifact_version": {
      "const": "0.1.1"
    },
    "issue_count": {
      "minimum": 0,
      "type": "integer"
    },
    "issues": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "problem": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "problem"
        ],
        "type": "object"
      },
      "type": "array",
      "uniqueItems": true
    },
    "participant_contract_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "response_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "role_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "failed",
        "passed"
      ]
    },
    "task_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "template_schema_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "template_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "$schema",
    "artifact_type",
    "artifact_version",
    "issue_count",
    "issues",
    "participant_contract_schema_sha256",
    "response_schema_sha256",
    "role_schema_sha256",
    "status",
    "task_sha256",
    "template_schema_sha256",
    "template_sha256"
  ],
  "title": "Game Primitives Prediction Template Contract Check 0.1.1",
  "type": "object"
}
