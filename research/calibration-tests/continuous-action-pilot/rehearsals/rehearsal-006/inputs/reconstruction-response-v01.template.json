  "artifact_type": "reconstruction_response_template",
  "artifact_version": "0.1.1",
  "created_at": "2026-07-28T01:00:00Z",
  "participant_contract": {
    "artifact_type": "reconstruction_participant_response_contract",
    "artifact_version": "0.1.1",
    "confidence_percent_rule": {
      "maximum": 100,
      "minimum": 0,
      "template_slot": "<integer-0-100>",
      "type": "integer"
    },
    "integrity_exposure_item_shape": {
      "additionalProperties": false,
      "properties": {
        "affected_case_ids": {
          "items": {
            "pattern": "^(?:CA-R[1-3]|NEG-01)$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "type": "string"
        },
        "exposure_type": {
          "enum": [
            "answer_or_project_prediction",
            "formal_result",
            "non_dispatched_artifact",
            "other_condition",
            "other_submission",
            "outside_search",
            "raw_source_or_identity",
            "shared_workspace",
            "truth_nonce_or_mapping",
            "unfrozen_input"
          ]
        },
        "occurred_at": {
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "enum": [
            "prediction",
            "reconstruction",
            "source_audit"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "none",
            "suspected"
          ]
        }
      },
      "required": [
        "affected_case_ids",
        "description",
        "evidence",
        "exposure_type",
        "occurred_at",
        "stage",
        "status"
      ],
      "type": "object"
    },
    "local_id_pattern": "^[a-z0-9][a-z0-9._-]*$",
    "pollution_enums": {
      "exact_result_knowledge": [
        "known",
        "none",
        "suspected",
        "unknown"
      ],
      "exact_rule_knowledge": [
        "known",
        "none",
        "suspected",
        "unknown"
      ],
      "exact_variant_knowledge": [
        "known",
        "none",
        "suspected",
        "unknown"
      ],
      "integrity_exposure_type": [
        "answer_or_project_prediction",
        "formal_result",
        "non_dispatched_artifact",
        "other_condition",
        "other_submission",
        "outside_search",
        "raw_source_or_identity",
        "shared_workspace",
        "truth_nonce_or_mapping",
        "unfrozen_input"
      ],
      "integrity_stage": [
        "prediction",
        "reconstruction",
        "source_audit"
