      "reconstruction_answer": [
        "ambiguities",
        "assumptions",
        "case_id",
        "compatible_branches",
        "confidence_percent",
        "recovered_facts",
        "uniqueness"
      ],
      "reconstruction_payload": [
        "$schema",
        "artifact_type",
        "artifact_version",
        "pollution",
        "reconstruction_answers"
      ],
      "recovered_fact": [
        "claim",
        "fact_id",
