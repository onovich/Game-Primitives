    "artifact_type": "prediction_participant_response_contract",
    "artifact_version": "0.1.1",
    "cartesian_product_rule": {
      "applies_to": [
        "main_expectations",
        "each_compatible_alternative"
      ],
      "case_observations": [
        {
          "case_id": "CA-R2",
          "observation_ids": [
            "obs.total-at-stop"
          ]
        }
      ],
      "configuration_ids": [
        "config.baseline",
        "config.variant"
      ],
      "indeterminate_minimum_alternatives": 2,
      "pair_occurrence": "exactly_once"
    },
    "confidence_percent_rule": {
      "maximum": 100,
      "minimum": 0,
      "template_slot": "<integer-0-100>",
      "type": "integer"
    },
    "integrity_exposure_item_shape": {
      "additionalProperties": false,
      "properties": {
        "affected_case_ids": {
          "items": {
            "pattern": "^(?:CA-R[1-3]|NEG-01)$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "type": "string"
        },
        "exposure_type": {
          "enum": [
            "answer_or_project_prediction",
            "formal_result",
            "non_dispatched_artifact",
            "other_condition",
            "other_submission",
            "outside_search",
            "raw_source_or_identity",
            "shared_workspace",
            "truth_nonce_or_mapping",
            "unfrozen_input"
          ]
        },
        "occurred_at": {
          "oneOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "enum": [
            "prediction",
            "reconstruction",
            "source_audit"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "none",
            "suspected"
          ]
        }
      },
      "required": [
        "affected_case_ids",
        "description",
        "evidence",
        "exposure_type",
        "occurred_at",
        "stage",
        "status"
      ],
      "type": "object"
    },
    "local_id_pattern": "^[a-z0-9][a-z0-9._-]*$",
    "observation_rules": [
      {
        "allowed_value_types": [
          "integer",
          "status"
        ],
        "case_id": "CA-R2",
        "compatible_alternative_unit": "count",
        "declared_unit": "count",
        "determinate_value_types": [
          "integer"
        ],
        "main_unit_options": [
          null,
          "count"
        ],
        "observation_id": "obs.total-at-stop",
        "tolerance_rule_id": "tol.synthetic.exact"
      }
    ],
